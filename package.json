{
  "name": "LORPlusModManager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "imports": {
    "#*": {
      "types": "./src/app/*",
      "default": "./dist/app/*"
    }
  },
  "description": "Mod manager for the game Last Origin R+",
  "main": "dist/app/index.js",
  "scripts": {
    "dev:ui": "vite",
    "dev:electron": "pnpm build:electron && electron .",
    "build:ui": "vite build",
    "build:electron": "tsc -p tsconfig.preload.json && tsc -p tsconfig.app.json",
    "build:unity-worker": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity-worker/build.ps1",
    "build": "pnpm build:unity-worker && pnpm build:ui && pnpm build:electron",
    "dist": "pnpm build && electron-builder --win --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.9.0",
      "onFail": "ignore"
    }
  },
  "dependencies": {
    "@esotericsoftware/spine-pixi-v8": "4.2.119",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "fs-extra": "^11.3.6",
    "pinia": "^3.0.4",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.19.0",
    "unzipper": "^0.12.5",
    "vue": "^3.5.39",
    "winreg": "^1.2.5"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.0.1",
    "@types/unzipper": "^0.10.11",
    "@types/winreg": "^1.2.36",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.6.0",
    "eslint-plugin-vue": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vue-tsc": "^3.3.5"
  }
}
